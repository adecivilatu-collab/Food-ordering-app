# Copy to .env for local dev — all free, $0
DATABASE_URL=postgres://food:food@localhost:5432/fooddb
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=food-images
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
# Note: localstack s3 starting deferred on Windows; use Supabase Storage Free if needed
JWT_SECRET=change-me-dev-only
# Payments — test mode free, no charge until live
PAYSTACK_SECRET_KEY=sk_test_xxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxx
# Auth/notify — free now (console OTP + email); SMS deferred to pilot
OTP_MODE=console
RESEND_API_KEY=
# Maps — free OSM, no key needed
MAP_PROVIDER=osm
