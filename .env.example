# Copy to .env for local dev — locked stack, $0 upfront
DATABASE_URL=postgres://food:food@localhost:5432/fooddb
REDIS_URL=redis://localhost:6379
# Cloudflare R2 (S3-compatible) — food images
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=food-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Better Auth
BETTER_AUTH_SECRET=change-me-dev-only
BETTER_AUTH_URL=http://localhost:3000
# Auth/OTP — console in dev, ZeptoMail for email
OTP_MODE=console
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_FROM=noreply@yourdomain.com
# Payments — Paystack test mode free
PAYSTACK_SECRET_KEY=sk_test_xxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxx
# Maps — free OSM, no key
MAP_PROVIDER=osm
# Hosting — local device (Docker Compose), no deploy yet
HOSTING=local
