{
  "name": "food-marketplace-tokens",
  "version": "0.2.0",
  "tokens": {
    "color": {
      "primary": "#FF5A00",
      "primaryDark": "#C43D00",
      "accent": "#FFD600",
      "success": "#00C853",
      "successDark": "#007A33",
      "warning": "#FFAB00",
      "danger": "#FF1744",
      "info": "#00B0FF",
      "text": "#0B0B0B",
      "muted": "#3D3D3D",
      "background": "#FFFFFF",
      "surface": "#FFF4E0"
    },
    "font": {
      "family": "Inter, system-ui, sans-serif",
      "sizes": [12, 14, 16, 20, 24, 32],
      "weights": [400, 500, 700, 800]
    },
    "spacing": 4,
    "radius": [8, 12, 16],
    "imagery": {
      "restaurantBanner": "16:9 min 800px",
      "food": "1:1 min 800px",
      "placeholder": "blur-up"
    },
    "rules": {
      "minTouch": 44,
      "priceMinSize": 16,
      "currency": "NGN kobo integer, format ₦",
      "contrast": "Black text on bright fills; white text only on primaryDark/successDark/danger for sharp contrast"
    }
  }
}
