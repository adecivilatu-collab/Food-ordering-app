{
  "name": "food-marketplace-tokens",
  "version": "0.3.0",
  "tokens": {
    "color": {
      "primary": "#2D5A3D",
      "primaryDark": "#1B3A28",
      "accent": "#C8A86B",
      "clay": "#8B5E3C",
      "success": "#3E7C4F",
      "warning": "#D9A441",
      "danger": "#B3402A",
      "info": "#5B8E9E",
      "text": "#23282B",
      "muted": "#5A6366",
      "background": "#FAF7F0",
      "surface": "#EDE8DC"
    },
    "font": {
      "family": "Inter, system-ui, sans-serif",
      "sizes": [12, 14, 16, 20, 24, 32],
      "weights": [400, 500, 700]
    },
    "spacing": 4,
    "radius": [8, 12, 16],
    "imagery": {
      "restaurantBanner": "16:9 min 800px",
      "food": "1:1 min 800px",
      "placeholder": "blur-up"
    },
    "rules": {
      "minTouch": 44,
      "priceMinSize": 16,
      "currency": "NGN kobo integer, format ₦",
      "contrast": "White text on primary/primaryDark/clay/danger; dark text on accent/surface/background",
      "theme": "Cool calabash: deep gourd green, dried-gourd tan, clay, stone grey, realistic warm neutrals"
    }
  }
}
